{
  "expo": {
    "name": "Tay Préstamos",
    "slug": "tay-prestamos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tayprestamos",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.michaelzapataag.tayprestamos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.michaelzapataag.tayprestamos",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#ECFDF5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3FF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para adjuntar comprobantes de pago de los préstamos.",
          "cameraPermission": "La app usa la cámara para tomar fotos de comprobantes de pago."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/tay"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {}
    }
  }
}
